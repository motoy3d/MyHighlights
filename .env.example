APP_NAME=Tsubasa⬆︎UP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tsubasa
DB_USERNAME=tsubasa
DB_PASSWORD=

# 同一オリジンのSPAからのAPIリクエストをセッション認証で通すための設定。
# 未設定でもAPP_URLのホストは自動的に対象になる。
SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=129600
# HTTPS運用では true にする
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=system@smartj.mobi
MAIL_FROM_NAME=横浜SCつばさアプリ

# Amazon SES / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=

# アプリ用
SCHEDULE_DATA_LOADING_MONTHS=12
TIMELINE_LOAD_POSTS=10
TEST_IP=192.168.11.3

