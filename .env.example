APP_NAME=Tsubasa⬆︎UP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# ⚠ APP_URL は実際にブラウザからアクセスするURLと
#   スキーム・ホスト・ポートまで完全に一致させること。
#   Sanctumはこの値を元に「自サイトのSPAからのリクエストか」を判定するため、
#   ずれていると /api/* が全て401になり、
#   /home と /login の間で無限リダイレクトになる。
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tsubasa
DB_USERNAME=tsubasa
DB_PASSWORD=

# 同一オリジンのSPAからのAPIリクエストをセッション認証で通すための設定。
# 行ごと書かなければAPP_URLのホスト(:ポート)が自動的に対象になるため、
# APP_URLが正しければ書かなくてよい。
# ⚠ 「SANCTUM_STATEFUL_DOMAINS=」と空で書くと自動の対象が無効になり、/api/* が全て401になる。
# 本番例: SANCTUM_STATEFUL_DOMAINS=tsubasa.smartj.mobi
# SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=129600
# HTTPS運用では true にする
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=system@smartj.mobi
MAIL_FROM_NAME=横浜SCつばさアプリ

# Amazon SES / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=

# アプリ用
SCHEDULE_DATA_LOADING_MONTHS=12
TIMELINE_LOAD_POSTS=10
TEST_IP=192.168.11.3

# Webプッシュ通知(#110)
# 鍵は `php artisan webpush:vapid` で作る。作り直すと全員の購読が無効になるので注意。
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 公開する利用者: 空=誰にも出さない / *=全員 / カンマ区切りのメールアドレス
PUSH_ENABLED_EMAILS=
# プッシュ用のキュー名(任意)。設定する場合はワーカーを --queue=push,default で起動すること
PUSH_QUEUE=

