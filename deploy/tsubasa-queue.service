# キューワーカー。旧 supervisord.conf の live_scouter_mp4_batch の置き換え。
#
#   sudo cp deploy/tsubasa-queue.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tsubasa-queue
#
[Unit]
Description=Tsubasa UP queue worker
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=apache
Group=apache
WorkingDirectory=/var/www/MyHighlights
# --sleep は仕事が無いときに次を見に行くまでの秒数。旧サーバの 60 のままだと、
# プッシュ通知(#110)が最大 1 分遅れる。3 秒ごとの確認は jobs テーブルへの軽い問い合わせ 1 回で、負荷は無視できる
ExecStart=/usr/bin/php artisan queue:work --timeout=3600 --sleep=3 --tries=3
# デプロイ時に `php artisan queue:restart` を実行すると、ワーカーが
# 現在のジョブを終えてから自分で終了する。systemdがそれを再起動する。
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# 最低限のサンドボックス化
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
